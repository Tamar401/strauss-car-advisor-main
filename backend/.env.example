# מעתיקים ל-.env וממלאים. קובץ .env לא נכנס ל-git.
GEMINI_API_KEY=
# המודל הראשי + גיבוי (בעומס או חריגה ממכסה עוברים לגיבוי). לבדוק ב-AI Studio מה זמין לחשבון
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# קודי גישה למסכי הנציג והכללים. ריק = מצב פיתוח פתוח (לא להשאיר ריק בהעלאה לאוויר!)
REP_ACCESS_CODE=
# פרטי כניסת מנהל/ת — יש לבחור שם משתמש וסיסמה חזקה באורך 12 תווים לפחות לפני הפעלה
ADMIN_USERNAME=
ADMIN_PASSWORD=

# כמה ימים שומרים שיחות (נתוני שכר) לפני מחיקה אוטומטית
RETENTION_DAYS=30
# כתובות הממשק שמורשות לפנות לשרת (מופרד בפסיקים)
CORS_ORIGINS=http://localhost:5173
# פיילוט עם נתונים אמיתיים: Vertex AI במקום מפתח API (ראו docs/PRIVACY.md)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=europe-west1
